{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Mobile platform permissions",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "allow-custom-reminder-settings",
    "core:default",
    "core:event:default",
    "core:path:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-open",
    "fs:allow-write-file",
    "fs:allow-remove",
    "dialog:default",
    "sql:default",
    "log:default",
    "notification:default",
    "allow-request-permission-on-android",
    "allow-show-notification",
    "allow-clear-notification",
    "allow-get-notifications-enabled",
    "allow-set-notifications-enabled",
    "allow-get-notification-sound-enabled",
    "allow-set-notification-sound-enabled",
    "allow-notification-settings",
    "allow-notification-records",
    "allow-notification-action",
    "allow-notification-test",
    "allow-get-background-receive-state",
    "allow-get-background-runtime-settings",
    "allow-set-background-runtime-settings",
    "allow-retry-background-service",
    "allow-stop-background-receive-and-exit",
    "allow-get-battery-optimization-state",
    "allow-open-battery-optimization-settings",
    "allow-get-notification-permission-state",
    "allow-start-tray-flash",
    "allow-stop-tray-flash",
    "allow-open-saf-picker",
    "allow-get-my-name",
    "allow-get-my-id",
    "allow-update-my-name",
    "allow-get-peers",
    "allow-send-message",
    "allow-get-chat-history",
    "allow-get-chat-history-with-offset",
    "allow-send-file",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-theme-list",
    "allow-get-theme-css",
    "allow-save-current-theme",
    "allow-get-current-theme",
    "allow-accept-file",
    "allow-get-default-download-path",
    "allow-request-storage-permission",
    "allow-save-file-message",
    "allow-open-file-location",
    "allow-set-android-shared-files",
    "allow-get-android-shared-files",
    "allow-clear-android-shared-files",
    "allow-send-file-from-fd",
    "allow-share-file-to-other-app",
    "allow-open-file-in-android",
    "allow-get-android-file-state",
    "allow-get-media-token",
    "allow-close-android-fd",
    "allow-delete-messages",
		"allow-clear-chat-history",
		"allow-delete-user-complete",
		"allow-clear-offline-peers",
		"allow-get-custom-peers",
		"allow-add-custom-peer",
		"allow-remove-custom-peer",
		"allow-request-file",
		"allow-get-language",
		"allow-set-language"
  ],
  "scope": {
    "allow": [
      { "path": "**" }
    ]
  }
}
